{
  "expo": {
    "name": "karikko",
    "slug": "karikko",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "fi.karikko.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Karikko käyttää kameraa matalikkomerkintöjen valokuvaamiseen.",
        "NSPhotoLibraryUsageDescription": "Karikko voi liittää kuvan matalikkomerkintään galleriasta."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "fi.karikko.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sqlite",
      "@maplibre/maplibre-react-native",
      [
        "expo-image-picker",
        {
          "photosPermission": "Karikko voi liittää kuvan matalikkomerkintään galleriasta.",
          "cameraPermission": "Karikko käyttää kameraa matalikkomerkintöjen valokuvaamiseen."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "92f2605d-d882-44ba-aa48-3fbd9ae25348"
      }
    },
    "owner": "mikkotark"
  }
}
